<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_kabut"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <!-- Background Header Wave Vector -->
        <View
            android:id="@+id/background_header"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_header_wave"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header Greeting -->
        <TextView
            android:id="@+id/tvGreetingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Selamat Datang,"
            android:textColor="@color/gray_text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/background_header" />

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_ink_dark"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreetingLabel"
            tools:text="User Seimbang" />

        <!-- Menu Fitur GridLayout (3 Kolom) -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            app:columnCount="3"
            app:useDefaultMargins="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUsername">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Hitung BMI"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Riwayat"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Grafik"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Tips Sehat"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Artikel"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Profil"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal"
                app:strokeColor="@color/primary_teal" />
        </androidx.gridlayout.widget.GridLayout>

        <!-- Card Ringkasan BMI Terakhir -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLatestBmi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gridMenu">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Status BMI Terakhir"
                    android:textColor="@color/text_ink_dark"
                    android:textSize="16sp" />

                <com.example.mfahrezy_project_24tic.BmiGaugeView
                    android:id="@+id/bmiGaugeHome"
                    android:layout_width="220dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Tips & Saran Hari Ini -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/surface_mint"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardLatestBmi">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="💡 Saran Hari Ini"
                    android:textColor="@color/text_ink_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTipDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Pertahankan pola makan seimbang dan konsumsi air putih minimal 2 liter sehari untuk menjaga BMI tetap dalam rentang normal."
                    android:textColor="@color/text_ink_dark"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Akses Fitur P10 (TabLayout & RecyclerView) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToTenth"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/primary_teal"
            android:fontFamily="@font/poppins_bold"
            android:text="Fitur Tab &amp; Riwayat (P10)"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTips" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>