<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_kabut"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header Greeting -->
        <TextView
            android:id="@+id/tvGreetingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Selamat Datang,"
            android:textColor="@color/gray_text_secondary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_ink_dark"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreetingLabel"
            tools:text="User Seimbang" />

        <!-- Card Ringkasan BMI Terakhir -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLatestBmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvUsername">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Status BMI Terakhir"
                    android:textColor="@color/text_ink_dark"
                    android:textSize="16sp" />

                <com.example.mfahrezy_project_24tic.BmiGaugeView
                    android:id="@+id/bmiGaugeHome"
                    android:layout_width="220dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Tips & Saran Hari Ini -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_mint"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/cardLatestBmi">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="💡 Saran Hari Ini"
                    android:textColor="@color/text_ink_dark"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTipDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Pertahankan pola makan seimbang dan konsumsi air putih minimal 2 liter sehari untuk menjaga BMI tetap dalam rentang normal."
                    android:textColor="@color/text_ink_dark"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Ke Detail Projek (Fitur Existing) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeDetail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary_teal"
            android:fontFamily="@font/poppins_bold"
            android:text="Ke Detail Projek"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="26dp"
            app:layout_constraintTop_toBottomOf="@+id/cardTips" />

        <!-- Tombol Baca Artikel Sehat (WebView) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWebArticle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Baca Artikel Sehat"
            android:textColor="@color/primary_teal"
            android:textSize="14sp"
            app:cornerRadius="26dp"
            app:strokeColor="@color/primary_teal"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toBottomOf="@+id/btnKeDetail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>