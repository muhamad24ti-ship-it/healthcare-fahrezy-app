<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tenth.TenthActivity">

    <!-- Toolbar Aplikasi -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTenth"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#00897B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_home"
        app:navigationIconTint="@color/white"
        app:title="Seimbang - P10 (Tab &amp; Recycler)"
        app:titleTextAppearance="@style/ToolbarTitleStyle"
        app:titleTextColor="@color/white" />

    <!-- TabLayout Utama -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutTenth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00897B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarTenth"
        app:tabIndicatorColor="@color/white"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="#B2DFDB" />

    <!-- ViewPager2 Kontainer Fragment -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTenth"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayoutTenth" />

</androidx.constraintlayout.widget.ConstraintLayout>